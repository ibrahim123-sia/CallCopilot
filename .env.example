# ==============================================================================
# CallCopilot configuration — copy to .env and fill in GEMINI_API_KEY
# ==============================================================================

# Groq API key (recommended). Free: https://console.groq.com/keys
# Tried FIRST for suggestions, Roman Urdu captions, summaries and chat (very fast).
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API key (required for live captions). Free, no card: https://aistudio.google.com/apikey
# Does live speech-to-text, and is the automatic fallback when Groq is rate-limited or fails.
GEMINI_API_KEY=your_gemini_api_key_here

# Models (defaults are free-tier models; each task uses its own model so their
# per-model free quotas don't compete). Usually leave these as they are.
# Real-time speech-to-text (Live API)
GEMINI_STT_MODEL=gemini-3.5-transcribe-live
# Live suggestions & quick lookups
GEMINI_LIVE_MODEL=gemini-3.5-flash-lite
# Live Roman Urdu captions
GEMINI_TRANSLATE_MODEL=gemini-3.1-flash-lite
# Summaries, client brief, chat
GEMINI_MODEL=gemini-3.8-flash

# Groq models (free tier). Requests larger than GROQ_MAX_TOKENS_PER_REQUEST
# (prompt + answer) skip Groq and go to Gemini, because Groq's free tier has
# small tokens-per-minute limits.
GROQ_LIVE_MODEL=openai/gpt-oss-20b
GROQ_TRANSLATE_MODEL=qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS_PER_REQUEST=7000

# Optional: Deepgram instead of Gemini for transcription (paid after trial credit).
# The key needs Member (or higher) role so the server can mint short-lived browser tokens.
DEEPGRAM_API_KEY=

# Where client data is stored (SQLite file on this computer)
# DATABASE_PATH=./data/callcopilot.db

# Safety limit for analysis requests per minute
RATE_LIMIT_PER_MINUTE=60
