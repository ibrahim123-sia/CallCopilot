# ==============================================================================
# CallCopilot Environment Variables Configuration
# ==============================================================================

# Google Gemini API Key (Required for live AI analysis & summarization)
# Obtain free from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model for post-call summaries (Default: gemini-3.8-flash)
# Options: gemini-3.8-flash, gemini-4-argon (best quality), gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# Gemini model for low-latency live analysis & lookups (Default: gemini-3.5-flash-lite)
GEMINI_LIVE_MODEL=gemini-3.5-flash-lite

# Deepgram API Key (Required for live transcription)
# Needs Member (or higher) role so the server can mint short-lived browser tokens.
# Obtain from Deepgram Console: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Rate Limiting & Safety
# Maximum requests per minute per IP for analysis endpoints (Default: 60)
RATE_LIMIT_PER_MINUTE=60

# Max transcript history buffer length (in characters, default: 40000)
MAX_TRANSCRIPT_BUFFER_CHARS=40000
