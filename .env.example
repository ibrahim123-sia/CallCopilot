# ==============================================================================
# CallCopilot Environment Variables Configuration
# ==============================================================================

# Google Gemini API Key (Required for live AI analysis & summarization)
# Obtain free from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (Default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Deepgram API Key (Required for real-time speech-to-text token vending)
# Obtain from Deepgram Console: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Optional: Deepgram Project ID (If generating scoped temporary project keys)
DEEPGRAM_PROJECT_ID=

# Rate Limiting & Safety
# Maximum requests per minute per IP for analysis endpoints (Default: 60)
RATE_LIMIT_PER_MINUTE=60

# Max transcript history buffer length (in characters, default: 40000)
MAX_TRANSCRIPT_BUFFER_CHARS=40000
