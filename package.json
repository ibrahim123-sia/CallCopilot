{
  "name": "callcopilot",
  "version": "1.0.0",
  "private": true,
  "description": "Live client-call assistant with real-time transcription, insight cards, NEW detection, and post-call PDF report.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "node scripts/build-docs.mjs",
    "cf:build": "cross-env CF_BUILD=1 opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:db:migrate:local": "wrangler d1 migrations apply callcopilot --local",
    "cf:db:migrate:remote": "wrangler d1 migrations apply callcopilot --remote",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false cloudflare-env.d.ts",
    "cf:size": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cf:export-local": "node scripts/export-local-to-d1.mjs"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@google/genai": "^2.29.0",
    "@opennextjs/cloudflare": "^1.20.12",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.13.0",
    "minisearch": "^7.2.0",
    "next": "^15.2.0",
    "puppeteer": "^24.43.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "unpdf": "^1.9.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.17.19",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.2.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.151.1"
  }
}
